# Choose: nexus, openai or anthropic
AI_PROVIDER=nexus

# NEXUS 1 PRO API (keep secret on the server)
NEXUS_API_KEY=
NEXUS_MODEL=NEXUS 1 PRO

# OpenAI or OpenAI-compatible API (optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional comma-separated model allowlist for the header picker
# AI_MODELS=gpt-4o-mini,gpt-4.1
# Optional compatible endpoint, e.g. your trusted gateway
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic alternative (set AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

API_PORT=8787
